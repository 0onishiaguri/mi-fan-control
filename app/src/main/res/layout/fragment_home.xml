<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="false">

    <!-- 固定悬浮顶部标题栏（原 activity_main 中的部分） -->
    <LinearLayout
        android:id="@+id/top_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="1dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MiFan Control"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="酷安@往不忆 Great with ChatGPT"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="80dp">

            <!-- ========== 风扇主状态大卡片 ========== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:tag="blue_card"
                android:clipToOutline="true"
                android:padding="25dp"
                android:layout_marginBottom="16dp">

                <!-- 居中风扇组件 -->
                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/iv_fan_border"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/fan_layer1"
                        android:scaleType="centerInside"
                        android:importantForAccessibility="no" />

                    <FrameLayout
                        android:id="@+id/fl_fan_blade"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:layerType="hardware">

                        <ImageView
                            android:id="@+id/iv_fan_blade"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/fan_layer2"
                            android:scaleType="centerInside"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/iv_fan_blade_light"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/fan_blade_layer2"
                            android:scaleType="centerInside"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/iv_fan_shadow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/fan_layer4"
                        android:scaleType="centerInside"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/iv_fan_light"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/fan_light_layer2"
                        android:alpha="0.0"
                        android:scaleType="centerInside"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/iv_fan_turbine"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/fan_layer7"
                        android:scaleType="centerInside"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <!-- 左上：设备温度 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|left"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_main_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0°"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设备温度"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- 右上：风扇档位 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|right"
                    android:orientation="vertical"
                    android:gravity="right">
                    <TextView
                        android:id="@+id/tv_main_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关闭"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="风扇档位"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- 左下：实时PWM值 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_speed_ratio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PWM值"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- 右下：实时转速 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|right"
                    android:orientation="vertical"
                    android:gravity="right">
                    <TextView
                        android:id="@+id/tv_main_rpm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="实时转速"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- ========== 快捷档位控制卡片（已移除充电狂暴开关） ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:tag="blue_card"
                android:clipToOutline="true"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="快捷档位控制"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp" />

                <com.fan.widget.QuickLevelPicker
                    android:id="@+id/quick_level_picker"
                    android:layout_width="match_parent"
                    android:layout_height="52dp" />
            </LinearLayout>

            <!-- ========== 温度节点切换卡片 ========== -->
            <LinearLayout
                android:id="@+id/card_temp_node"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_background"
                android:tag="blue_card"
                android:clipToOutline="true"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前温度读取节点"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tv_temp_node_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="主核心温度"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_temp_node_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="切换温度读取节点"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- ========== 曲线图 & 控制模式 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- 左侧：实时曲线图 + 电池状态 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:tag="blue_card"
                        android:clipToOutline="true"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="实时数据曲线"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:layout_marginBottom="6dp" />
                        <com.fan.widget.SimpleLineChartView
                            android:id="@+id/chart_realtime"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginTop="4dp">
                            <View
                                android:layout_width="12dp"
                                android:layout_height="3dp"
                                android:background="#2D7DFF"
                                android:layout_marginEnd="4dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="转速"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:layout_marginEnd="12dp" />
                            <View
                                android:layout_width="12dp"
                                android:layout_height="3dp"
                                android:background="#FF9800"
                                android:layout_marginEnd="4dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="温度"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 电池状态卡片 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_background"
                        android:tag="blue_card"
                        android:clipToOutline="true"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="电池状态"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp" />
                            <TextView
                                android:id="@+id/tv_battery_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="未充电"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="电池温度"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp" />
                            <TextView
                                android:id="@+id/tv_battery_temp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--°"
                                android:textColor="#00C853"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 右侧：控制模式 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:tag="blue_card"
                    android:clipToOutline="true"
                    android:padding="12dp"
                    android:layout_marginStart="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="风扇控制模式"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                        <ImageView
                            android:id="@+id/iv_mode_help"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_dialog_info"
                            app:tint="@color/text_secondary"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                    <RadioGroup
                        android:id="@+id/rg_control_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/rb_mode_system"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="控制中心联调"
                            android:textSize="15sp"
                            android:buttonTint="#2D7DFF"
                            android:paddingVertical="4dp" />
                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/rb_mode_low"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="底层写入控制"
                            android:textSize="15sp"
                            android:buttonTint="#2D7DFF"
                            android:paddingVertical="4dp" />
                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/rb_mode_smart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="智能调频模式"
                            android:textSize="15sp"
                            android:buttonTint="#2D7DFF"
                            android:paddingVertical="4dp" />
                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/rb_mode_app"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="应用自定义"
                            android:textSize="15sp"
                            android:buttonTint="#2D7DFF"
                            android:paddingVertical="4dp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>

            <!-- ========== 无级调速卡片（默认隐藏） ========== -->
            <LinearLayout
                android:id="@+id/card_pwm_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:clipToOutline="true"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="无级转速调节"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <SeekBar
                        android:id="@+id/seek_pwm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="99"
                        android:progress="0"
                        android:progressDrawable="@drawable/seek_track"
                        android:thumb="@drawable/seek_thumb"
                        android:splitTrack="false"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />
                    <TextView
                        android:id="@+id/tv_pwm_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========== 智能曲线编辑卡片（默认隐藏） ========== -->
            <LinearLayout
                android:id="@+id/card_smart_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:clipToOutline="true"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="自定义温控曲线"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_edit_curve"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="编辑曲线"
                        android:textColor="#2D7DFF"
                        android:textSize="14sp"
                        android:clickable="true" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="拖动节点自定义温度‑转速对应关系"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ========== 应用自定义卡片（默认隐藏） ========== -->
            <LinearLayout
                android:id="@+id/card_app_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:clipToOutline="true"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="应用场景配置"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_add_app_config"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="添加配置"
                        android:textColor="#2D7DFF"
                        android:textSize="14sp"
                        android:clickable="true" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="指定APP启动时自动切换对应风扇模式"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ========== 底部服务状态 & 运行时长 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/item_service_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:tag="blue_card"
                    android:clipToOutline="true"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="后台服务"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tv_service_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检测中"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击重启服务"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:tag="blue_card"
                    android:clipToOutline="true"
                    android:padding="16dp"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="运行时长"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tv_run_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0小时0分"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="统计风扇开启时间"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>