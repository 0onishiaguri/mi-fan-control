<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="55dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/float_card_background"
    android:paddingHorizontal="8dp"
    android:paddingVertical="5dp">

    <LinearLayout
        android:id="@+id/row_mode"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/float_lb_mode"
            android:text="档位"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/float_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:layout_marginTop="1dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_temp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/float_lb_temp"
            android:text="温度"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/float_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:layout_marginTop="1dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_rpm"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/float_lb_rpm"
            android:text="转速"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/float_rpm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:layout_marginTop="1dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_power"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/float_lb_power"
            android:text="功耗"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/float_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:layout_marginTop="1dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_pwm"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/float_lb_pwm"
            android:text="PWM"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/float_pwm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:layout_marginTop="1dp"/>
    </LinearLayout>

</LinearLayout>
