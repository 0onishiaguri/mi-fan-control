<?xml version="1.0" encoding="utf-8"?>
<!--
  通知栏展开视图：数据行与折叠视图一致（左/中/右三位置自定义数据）
  + 四个功能按钮（带底色：关闭灰/高速蓝/狂暴红/悬浮窗绿）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="3dp">

    <!-- 数据行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:gravity="center_vertical">

        <!-- 位置 -->
    <LinearLayout
        android:id="@+id/slot_lt"
        android:layout_width="wrap_content"
                android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/lt_lb_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="档位："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_v_mode"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="关闭"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_lb_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="转速："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_v_speed"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_lb_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="温度："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_v_temp"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="0°"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_lb_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功耗："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_v_power"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="-3.2W"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_lb_pwm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PWM："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_v_pwm"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="80%"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        </LinearLayout>

        <TextView
            android:id="@+id/sep1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="|"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginHorizontal="1dp"/>

        <!-- 位置 -->
    <LinearLayout
        android:id="@+id/slot_mt"
        android:layout_width="wrap_content"
                android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/mt_lb_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="档位："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/mt_v_mode"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="关闭"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/mt_lb_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="转速："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/mt_v_speed"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/mt_lb_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="温度："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/mt_v_temp"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="0°"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/mt_lb_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功耗："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/mt_v_power"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="-3.2W"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/mt_lb_pwm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PWM："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/mt_v_pwm"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="80%"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        </LinearLayout>

        <TextView
            android:id="@+id/sep2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="|"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginHorizontal="1dp"/>

        <!-- 位置 -->
    <LinearLayout
        android:id="@+id/slot_rt"
        android:layout_width="wrap_content"
                android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/rt_lb_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="档位："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/rt_v_mode"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="关闭"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/rt_lb_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="转速："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/rt_v_speed"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/rt_lb_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="温度："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/rt_v_temp"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="0°"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/rt_lb_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功耗："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/rt_v_power"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="-3.2W"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/rt_lb_pwm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PWM："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/rt_v_pwm"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="80%"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        </LinearLayout>

    </LinearLayout>

    <!-- 按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="5dp"
        android:layout_marginTop="3dp">

        <TextView
            android:id="@+id/btn_close"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:text="关闭"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_notify_btn_close"
            android:gravity="center"/>

        <TextView
            android:id="@+id/btn_high"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:text="高速"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_notify_btn_high"
            android:gravity="center"
            android:layout_marginStart="4dp"/>

        <TextView
            android:id="@+id/btn_boost"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:text="狂暴"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_notify_btn_boost"
            android:gravity="center"
            android:layout_marginStart="4dp"/>

        <TextView
            android:id="@+id/btn_float"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:text="悬浮窗"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_notify_btn_float"
            android:gravity="center"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

</LinearLayout>
