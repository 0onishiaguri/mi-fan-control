<?xml version="1.0" encoding="utf-8"?>
<!--
  通知栏折叠视图：左/中/右三个位置，每个位置从 档位/转速/温度/功耗/PWM 中选择一项显示。
  运行时通过 setViewVisibility 只显示所选组，名称与数值同色同号（14sp 加粗，数值超长自动缩小至 10sp 完整显示），组间竖线分隔。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="7dp">

    <!-- 位置 -->
    <LinearLayout
        android:id="@+id/slot_lt"
        android:layout_width="wrap_content"
                android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/lt_lb_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="档位："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_v_mode"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="关闭"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_lb_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="转速："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_v_speed"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_lb_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="温度："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_v_temp"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="0°"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_lb_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功耗："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_v_power"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="-3.2W"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_lb_pwm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PWM："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/lt_v_pwm"
            android:layout_width="wrap_content"
            android:maxWidth="52dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:layout_height="wrap_content"
            android:text="80%"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"/>
    </LinearLayout>

    <TextView
        android:id="@+id/sep1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="|"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:layout_marginHorizontal="1dp"/>

