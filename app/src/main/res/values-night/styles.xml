<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SpinnerDropItem">
        <item name="android:layout">@layout/spinner_drop_item</item>
    </style>

    <style name="AppSpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/spinner_drop_bg</item>
        <item name="android:elevation">12dp</item>
        <item name="popupTheme">@style/SpinnerPopupDark</item>
    </style>

    <style name="SpinnerPopupDark" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:dropDownListViewStyle">@style/SpinnerDropItem</item>
        <item name="android:windowBackground">@drawable/spinner_drop_bg</item>
    </style>


</resources>